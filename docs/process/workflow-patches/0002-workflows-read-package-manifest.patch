From 0fd436454f9c1b637bc1d6c4afce75cccd53cf6f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 7 Oct 2026 15:30:17 +0000
Subject: [PATCH] ci(release): build-linux and pr-check read
 release/packages.toml

Workflow-only commit (the cloud GitHub App cannot push workflow files).
build-linux.yml (cargo build + required-bin check) and pr-check.yml
(linux cargo check) take their package and required-bin lists from
scripts/release-packages.sh. Both generated lists were diffed against the
hard-coded ones and are identical, in order (16 packages, 22 bins).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LRHkSGZVkQKmmHGiv24BGB
---
 .github/workflows/build-linux.yml | 41 +++++++++----------------------
 .github/workflows/pr-check.yml    | 22 ++++-------------
 2 files changed, 16 insertions(+), 47 deletions(-)

diff --git a/.github/workflows/build-linux.yml b/.github/workflows/build-linux.yml
index d46508cb..ad34b280 100644
--- a/.github/workflows/build-linux.yml
+++ b/.github/workflows/build-linux.yml
@@ -105,23 +105,11 @@ jobs:
           # with code from an unmerged branch, undetectable from the outside.
           PHILOTIC_BUILD_SHA: ${{ github.sha }}
         run: |
-          cargo build --release --target "${TARGET}" --bins \
-            -p aiua \
-            -p philote \
-            -p membrane-telegram \
-            -p membrane-discord \
-            -p membrane-mcp \
-            -p membrane-mcp-client \
-            -p egress-http-runner \
-            -p model-router \
-            -p tool-runner \
-            -p graph-datasource \
-            -p table-datasource \
-            -p router-listener \
-            -p agent-datasource \
-            -p heal-dispatcher \
-            -p data-memorygraphrag \
-            -p philotic-web
+          # Package set comes from release/packages.toml (single manifest).
+          read -r -a PKG_FLAGS <<< "$(scripts/release-packages.sh cargo-flags --platform linux)"
+          [ "${#PKG_FLAGS[@]}" -gt 0 ] || { echo "::error::release-packages.sh returned no packages"; exit 1; }
+          echo "packages: ${PKG_FLAGS[*]}"
+          cargo build --release --target "${TARGET}" --bins "${PKG_FLAGS[@]}"
 
       - name: Assemble dist/
         run: |
@@ -149,19 +137,12 @@ jobs:
         run: |
           set -euo pipefail
           missing=0
-          # Only binaries the package set actually emits. agent-core/hegemon are
-          # in philotic_binaries but are not build outputs (the ansible remote
-          # path stats-and-skips them), so they are intentionally NOT required here.
-          for bin in aiua philote philote-worker membrane-telegram membrane-discord membrane-mcp \
-                     membrane-mcp-client egress-http-runner \
-                     model-router model-controller-elevenlabs \
-                     model-controller-gemini model-controller-openai \
-                     model-controller-anthropic \
-                     model-controller-onnx model-controller-ollama \
-                     model-controller-decisions \
-                     tool-runner graph-datasource \
-                     agent-datasource heal-dispatcher life-graph-runner \
-                     philotic-web; do
+          # Required bins come from release/packages.toml (`required`). Bins a
+          # package may emit but that are optional (mlx, parakeet, ...) are not
+          # required here; the ansible remote path stats-and-skips them.
+          mapfile -t REQUIRED < <(scripts/release-packages.sh required-bins --platform linux)
+          [ "${#REQUIRED[@]}" -gt 0 ] || { echo "::error::release-packages.sh returned no required bins"; exit 1; }
+          for bin in "${REQUIRED[@]}"; do
             if [ ! -f "dist/$bin" ]; then
               echo "::error::expected binary missing from dist/: $bin"
               missing=$((missing + 1))
diff --git a/.github/workflows/pr-check.yml b/.github/workflows/pr-check.yml
index 8a9597aa..c6eb2075 100644
--- a/.github/workflows/pr-check.yml
+++ b/.github/workflows/pr-check.yml
@@ -135,23 +135,11 @@ jobs:
 
       - name: cargo check (vps-jane package set)
         run: |
-          cargo check --target x86_64-unknown-linux-gnu --bins \
-            -p aiua \
-            -p philote \
-            -p membrane-telegram \
-            -p membrane-discord \
-            -p membrane-mcp \
-            -p membrane-mcp-client \
-            -p egress-http-runner \
-            -p model-router \
-            -p tool-runner \
-            -p graph-datasource \
-            -p table-datasource \
-            -p router-listener \
-            -p agent-datasource \
-            -p heal-dispatcher \
-            -p data-memorygraphrag \
-            -p philotic-web
+          # Same list build-linux.yml and release.yml build: release/packages.toml.
+          read -r -a PKG_FLAGS <<< "$(scripts/release-packages.sh cargo-flags --platform linux)"
+          [ "${#PKG_FLAGS[@]}" -gt 0 ] || { echo "::error::release-packages.sh returned no packages"; exit 1; }
+          echo "packages: ${PKG_FLAGS[*]}"
+          cargo check --target x86_64-unknown-linux-gnu --bins "${PKG_FLAGS[@]}"
 
       - name: Save cargo cache
         if: always()
-- 
2.43.0

