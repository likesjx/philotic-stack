---
# host_vars/jane-vps.yml — copy to jane-vps.yml and fill in real values
# Sensitive fields (bot_token, api keys) should be stored in Ansible vault.

philotic_hotel_name: "default"
philotic_default_model: "gemini-pro"

# Backbone peers — other hotels this node should announce to.
# host is Tailscale MagicDNS name (transitional; will become explicit address).
philotic_backbone_peers:
  - name: "jane-vps"
    host: "jane-vps"
    beacon_port: 8999

# Agent configuration projected into mesh-config.json.
# Do not put secrets here — reference vault variables instead.
philotic_agents:
  jane:
    telegram:
      bot_token: "{{ vault_jane_telegram_bot_token }}"
      allowed_users: []
    model:
      default_model: "{{ philotic_default_model }}"

# Secrets file rendered separately and never committed.
# philotic_mesh_psk comes from vault.
