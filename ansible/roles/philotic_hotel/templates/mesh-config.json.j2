{
  "context_graph": {
    "default_model": "{{ philotic_default_model | default('gemini-pro') }}"{% if vault_gemini_api_key is defined and vault_gemini_api_key %},
    "gemini_api_key": "{{ vault_gemini_api_key }}"{% endif %}{% if vault_elevenlabs_api_key is defined and vault_elevenlabs_api_key %},
    "elevenlabs_api_key": "{{ vault_elevenlabs_api_key }}"{% endif %}{% if vault_elevenlabs_voice_id is defined and vault_elevenlabs_voice_id %},
    "elevenlabs_voice_id": "{{ vault_elevenlabs_voice_id }}"{% endif %}{% if philotic_oidc_public_base_url is defined and philotic_oidc_public_base_url | trim %},
    "oidc_public_base_url": "{{ philotic_oidc_public_base_url | trim }}"{% endif %}{% if vault_muninn_admin_password is defined %},
    "muninn": {
      "endpoint": "http://127.0.0.1:8475",
      "admin_username": "root",
      "admin_password": "{{ vault_muninn_admin_password }}"
    }{% endif %}
  },
  "hotels": {
    "{{ philotic_hotel_runtime_name }}": {
      "agents": {{ philotic_agents | to_nice_json }}{% if philotic_backbone_peers | length > 0 %},
      "backbone_peers": [
{% for peer in philotic_backbone_peers %}
        {
          "name": "{{ peer.name }}",
          "host": "{{ peer.host }}",
          "beacon_port": {{ peer.beacon_port | default(philotic_beacon_port) }}{% if peer.blob_port is defined %},
          "blob_port": {{ peer.blob_port }}{% endif %}{% if peer.execution_port is defined %},
          "execution_port": {{ peer.execution_port }}{% endif %}
        }{% if not loop.last %},{% endif %}
{% endfor %}
      ]{% endif %}
    }
  }
}
