[Unit]
Description=Philotic Hotel Daemon — {{ philotic_hotel_runtime_name }}
Documentation=https://github.com/your-org/philotic-stack
After=network-online.target tailscaled.service
Wants=network-online.target
# NOTE: tailscaled.service is a transitional dependency.
# Remove when native hotel VPN replaces Tailscale peer addressing.

[Service]
Type=simple
User={{ philotic_user }}
Group={{ philotic_group }}

WorkingDirectory={{ philotic_data_dir }}
RuntimeDirectory=philotic
RuntimeDirectoryMode=0755

# Runtime environment
Environment="RUST_LOG={{ philotic_rust_log }}"
Environment="PATH={{ philotic_bin_dir }}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PHILOTIC_BIN_DIR={{ philotic_bin_dir }}"
Environment="PHILOTIC_HOTEL_SOCKET={{ philotic_hotel_socket }}"
Environment="PHILOTIC_HOTEL_PORT={{ philotic_hotel_port }}"
Environment="PHILOTIC_ENABLE_RUST_AUTH={{ philotic_enable_rust_auth }}"
Environment="PHILOTIC_ENABLE_RUST_DISPATCHER={{ philotic_enable_rust_dispatcher }}"
Environment="PHILOTIC_ENABLE_RUST_TASK_LIFECYCLE={{ philotic_enable_rust_task_lifecycle }}"

# Mesh PSK — injected from Ansible vault; never stored in plaintext on disk
EnvironmentFile={{ philotic_etc_dir }}/secrets.env

ExecStart={{ philotic_bin_dir }}/aiua --hotel {{ philotic_hotel_runtime_name }}

Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# Hardening (progressive — tighten as hotel VPN and vault mature)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths={{ philotic_data_dir }} {{ philotic_blob_dir }} {{ philotic_runtime_dir }}
{% set read_only_paths = [] %}
{% for item in philotic_agents.values() %}
{% if item.import_workspace is defined %}
{% set _ = read_only_paths.append(item.import_workspace) %}
{% endif %}
{% endfor %}
{% if read_only_paths | length > 0 %}
ReadOnlyPaths={{ read_only_paths | join(' ') }}
{% endif %}
ProtectHome=yes

[Install]
WantedBy=multi-user.target
