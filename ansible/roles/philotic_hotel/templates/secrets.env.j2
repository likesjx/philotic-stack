# philotic-hotel runtime secrets
# Rendered by Ansible from vault — never committed to source control.
# Stored at {{ philotic_etc_dir }}/secrets.env (mode 0600, owned by philotic user).

{% if not (philotic_vault_key_via_load_credential | default(false) | bool) %}
{% if vault_philotic_vault_master_key is defined %}
PHILOTIC_VAULT_MASTER_KEY={{ vault_philotic_vault_master_key }}
{% endif %}
{% endif %}
{% if vault_philotic_memgraph_password is defined %}
PHILOTIC_MEMGRAPH_PASSWORD={{ vault_philotic_memgraph_password }}
{% endif %}
