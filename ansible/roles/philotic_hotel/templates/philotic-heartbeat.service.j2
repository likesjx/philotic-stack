[Unit]
Description=Philotic heartbeat — deterministic sensors that fire an agent turn only when needed
After=philotic-hotel.service philotic-memgraph.service
Wants=philotic-hotel.service

[Service]
Type=oneshot
# Root on purpose: the sensor needs docker exec (mgconsole) AND the
# philotic-owned hotel UDS in one short-lived, ansible-managed script.
User=root
ExecStart=/usr/local/bin/philotic-heartbeat.py
TimeoutStartSec=120
