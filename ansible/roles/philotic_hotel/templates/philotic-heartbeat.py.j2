#!/usr/bin/env python3
"""Philotic heartbeat — deterministic sensors that fire an agent turn ONLY
when there is real work.

Design (operator-directed, 2026-08-27): the sensing layer must be a plain
script — exact queries, real state stamps, no model. A model turn is spent
only when a check finds something, and that turn's job is delivery/judgment,
never re-discovery. Checks are functions returning (payload_message or None);
add new sensors to CHECKS.

v1 checks:
  reminders — due-dated live LifeGraph nodes entering the next window that
  have not been dispatched. Stamps reminder_dispatched_at for exact
  at-most-once dispatch (the 24h grace re-catches stragglers added late,
  still at most once). Delivery lines are pre-formatted HERE so the agent
  turn is pure transport; Beacon (chief of staff) is the only deliverer.

Runs as a systemd oneshot (root: needs docker exec for mgconsole AND the
hotel UDS). Managed by ansible — edit the template, not the installed file.
"""
import csv
import datetime
import io
import json
import socket
import struct
import subprocess
import sys

HOTEL_SOCK = "{{ philotic_hotel_socket }}"
HOTEL_NODE = "{{ philotic_hotel_runtime_name }}-aiua-01"
MEMGRAPH_CONTAINER = "philotic-memgraph"
BEACON_CHAT_ID = "{{ beacon_reminder_chat_id | default('7898847424') }}"
WINDOW_SECONDS = 5 * 60
GRACE_SECONDS = 24 * 3600

REMINDER_LABELS = ["NextAction", "Commitment", "Appointment", "Event", "OpenLoop"]
TERMINAL = ["retired", "done", "fulfilled", "abandoned", "resolved"]


def mgconsole(cypher: str) -> list[list[str]]:
    """Run one cypher statement; parse mgconsole CSV (values arrive wrapped
    in an extra quote layer)."""
    out = subprocess.run(
        ["docker", "exec", "-i", MEMGRAPH_CONTAINER, "mgconsole",
         "--output-format=csv"],
        input=cypher + ";\n", capture_output=True, text=True, timeout=30,
    )
    if out.returncode != 0:
        print(f"heartbeat: mgconsole failed: {out.stderr.strip()[:200]}",
              file=sys.stderr)
        return []
    rows = list(csv.reader(io.StringIO(out.stdout)))
    return [[cell.strip('"') for cell in row] for row in rows[1:]]


def emit_beacon_turn(message: str) -> bool:
    payload = json.dumps({
        "operation": "emit_task",
        "payload": {
            "target_node": HOTEL_NODE,
            "target_role": "role:agent-beacon:orchestrator",
            "target_guest_id": None,
            "task_json": json.dumps({
                "chat_id": BEACON_CHAT_ID,
                "source": "telegram",
                "content": message,
            }),
        },
    }).encode()
    reg = json.dumps({
        "operation": "register",
        "payload": {"guest_id": "philotic-heartbeat", "role": "membrane",
                    "supported_tools": []},
    }).encode()
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(15)
        s.connect(HOTEL_SOCK)
        for frame in (reg, payload):
            s.sendall(struct.pack(">I", len(frame)) + frame)
            hdr = b""
            while len(hdr) < 4:
                c = s.recv(4 - len(hdr))
                if not c:
                    raise RuntimeError("socket closed")
                hdr += c
            (length,) = struct.unpack(">I", hdr)
            body = b""
            while len(body) < length:
                c = s.recv(length - len(body))
                if not c:
                    raise RuntimeError("socket closed mid-frame")
                body += c
            resp = json.loads(body)
            if resp.get("ok") is False:
                print(f"heartbeat: emit refused: {json.dumps(resp)[:200]}",
                      file=sys.stderr)
                return False
        s.close()
        return True
    except OSError as e:
        print(f"heartbeat: hotel socket unavailable: {e}", file=sys.stderr)
        return False


def eastern(due_iso: str) -> str:
    try:
        dt = datetime.datetime.fromisoformat(due_iso.replace("Z", "+00:00"))
        try:
            from zoneinfo import ZoneInfo
            local = dt.astimezone(ZoneInfo("America/New_York"))
            return local.strftime("%Y-%m-%d %-I:%M %p %Z")
        except Exception:
            return due_iso
    except ValueError:
        return due_iso


def check_reminders(now: datetime.datetime):
    horizon = (now + datetime.timedelta(seconds=WINDOW_SECONDS)).strftime(
        "%Y-%m-%dT%H:%M:%SZ")
    grace = (now - datetime.timedelta(seconds=GRACE_SECONDS)).strftime(
        "%Y-%m-%dT%H:%M:%SZ")
    labels = ", ".join(f"'{l}'" for l in REMINDER_LABELS)
    terminal = ", ".join(f"'{t}'" for t in TERMINAL)
    rows = mgconsole(
        f"MATCH (n) WHERE any(l IN labels(n) WHERE l IN [{labels}]) "
        f"AND coalesce(n.validation_state, 'inferred') <> 'retired' "
        f"AND NOT coalesce(n.status, '') IN [{terminal}] "
        f"AND NOT coalesce(n.loop_status, '') IN [{terminal}] "
        f"AND n.due_at IS NOT NULL "
        f"AND n.due_at <= '{horizon}' AND n.due_at >= '{grace}' "
        f"AND n.reminder_dispatched_at IS NULL "
        f"RETURN n.id, n.due_at, substring(coalesce(n.claim_summary, ''), 0, 160) "
        f"ORDER BY n.due_at LIMIT 10"
    )
    if not rows:
        return None
    lines = [
        f"⏰ Reminder: {claim} (due {eastern(due)}) — {node_id}"
        for node_id, due, claim in rows
        if node_id
    ]
    ids = ", ".join(f"'{r[0]}'" for r in rows if r[0])
    stamp = now.strftime("%Y-%m-%dT%H:%M:%SZ")
    mgconsole(
        f"MATCH (n) WHERE n.id IN [{ids}] "
        f"SET n.reminder_dispatched_at = '{stamp}'"
    )
    body = "\n".join(lines)
    return (
        "Heartbeat reminder dispatch (deterministic pre-selection — do NOT "
        "re-query). Send the operator this reminder text as one Telegram "
        "message, verbatim:\n" + body
    )


CHECKS = [("reminders", check_reminders)]


def main() -> int:
    now = datetime.datetime.now(datetime.timezone.utc)
    fired = 0
    for name, check in CHECKS:
        message = check(now)
        if message:
            ok = emit_beacon_turn(message)
            print(f"heartbeat: check={name} fired emit_ok={ok}")
            fired += 1
        else:
            print(f"heartbeat: check={name} quiet")
    return 0 if fired >= 0 else 1


if __name__ == "__main__":
    sys.exit(main())
