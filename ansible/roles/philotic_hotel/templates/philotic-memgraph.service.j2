[Unit]
Description=Philotic Memgraph Central Cypher Store
After=network-online.target tailscaled.service docker.service
Wants=network-online.target tailscaled.service
Requires=docker.service

[Service]
Type=simple
Restart=on-failure
RestartSec=10

ExecStartPre=-/usr/bin/docker rm -f {{ philotic_memgraph_container_name }}
ExecStart=/usr/bin/docker run --rm \
  --name {{ philotic_memgraph_container_name }} \
  --publish {{ philotic_memgraph_host }}:{{ philotic_memgraph_port }}:7687 \
  --user {{ philotic_memgraph_uid }}:{{ philotic_memgraph_gid }} \
  --volume {{ philotic_memgraph_data_dir }}:/var/lib/memgraph \
  {{ philotic_memgraph_image }}
ExecStop=/usr/bin/docker stop {{ philotic_memgraph_container_name }}

[Install]
WantedBy=multi-user.target
