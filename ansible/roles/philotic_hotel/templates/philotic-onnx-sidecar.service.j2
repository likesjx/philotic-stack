[Unit]
Description=Philotic ONNX Sidecar — {{ philotic_hotel_name }} ({{ philotic_onnx_embed_dim }}-dim embeddings)
Documentation=https://github.com/your-org/philotic-stack
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ philotic_user }}
Group={{ philotic_group }}

WorkingDirectory={{ philotic_data_dir }}

# Runtime environment
Environment="RUST_LOG={{ philotic_rust_log }}"
Environment="PATH={{ philotic_bin_dir }}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PHILOTIC_BIN_DIR={{ philotic_bin_dir }}"
Environment="PHILOTIC_ONNX_SIDECAR_ADDR=127.0.0.1:{{ philotic_onnx_sidecar_port }}"
Environment="PHILOTIC_ONNX_EMBED_REPO={{ philotic_onnx_embed_repo }}"
Environment="PHILOTIC_ONNX_PREFER_QUANTIZED={{ philotic_onnx_prefer_quantized | lower }}"

# hf_hub (Rust) reads $HOME/.cache/huggingface — must match the philotic user home.
# HF_HOME is honoured by Python huggingface_hub but NOT by the hf_hub Rust crate.
Environment="HOME={{ philotic_home_dir }}"

ExecStart={{ philotic_bin_dir }}/model-controller-onnx \
  --sidecar-only \
  --sidecar-addr "127.0.0.1:{{ philotic_onnx_sidecar_port }}" \
  --embed-repo "{{ philotic_onnx_embed_repo }}" \
  --prefer-quantized "{{ philotic_onnx_prefer_quantized | lower }}"

Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths={{ philotic_data_dir }}
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
