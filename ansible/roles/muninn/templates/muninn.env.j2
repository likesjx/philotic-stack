# MuninnDB runtime secrets + hardened baseline.
# Rendered by Ansible from vault — never committed to source control.
# Stored at {{ muninn_home }}/muninn.env (mode 0600, owned by {{ muninn_user }}).
#
# MUNINN_ADMIN_PASSWORD rotates the root admin password on every daemon start
# (bootstrap re-hashes it), so this file is the single source of truth for
# admin auth — including on a freshly wiped data dir.
MUNINN_ADMIN_PASSWORD={{ vault_muninn_admin_password }}
{% if vault_muninn_mcp_token is defined %}
MUNINN_MCP_TOKEN={{ vault_muninn_mcp_token }}
{% endif %}
MUNINN_BACKUP_DIR={{ muninn_backup_dir }}
MUNINN_BACKUP_INTERVAL={{ muninn_backup_interval }}
MUNINN_BACKUP_RETAIN={{ muninn_backup_retain }}
